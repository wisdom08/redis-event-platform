# Local development only. Compose reads this file after copying it to .env.
# Export these variables in the shell as well when running bootRun.
DB_USERNAME=event_platform
DB_PASSWORD=local_password
DB_URL=jdbc:mysql://localhost:3306/event_platform?connectionTimeZone=UTC
MYSQL_ROOT_PASSWORD=local_root_password
REDIS_HOST=localhost
REDIS_PORT=6379
SERVER_PORT=8080
